# Copie este arquivo para .env para uso local.
# Na Vercel, configure estas variáveis em: Project Settings -> Environment Variables.
# NUNCA faça commit do arquivo .env no Git.

# Rota secreta do painel administrativo (ex.: /studio-admin ou /painel-pd-9x)
ADMIN_PATH=/studio-admin

# Segredo criptográfico para assinatura de sessão (gere com: python -c "import secrets; print(secrets.token_urlsafe(48))")
SESSION_SECRET=substitua_por_uma_chave_aleatoria_de_64_caracteres

# ── Produção na Vercel (Supabase PostgreSQL + Storage) ─────────────────────
# Deixe em branco localmente para usar SQLite; preencha na Vercel!
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_BUCKET=portfolio-media

# Em produção com HTTPS (Vercel ativa automaticamente), use true
COOKIE_SECURE=false

# Porta e host para rodar localmente
HOST=127.0.0.1
PORT=8000
